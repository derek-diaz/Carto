{
  "name": "carto",
  "version": "0.8.1",
  "private": true,
  "description": "Carto is a web-first app for inspecting Zenoh traffic.",
  "author": "Derek Diaz <derek.diaz@proton.me>",
  "license": "Apache-2.0",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:desktop": "electron-vite dev",
    "dev:web": "node node_modules/vite/bin/vite.js --config vite.config.mts",
    "dev:server": "node node_modules/tsx/dist/cli.mjs watch apps/server/src/server.ts",
    "dev:server:bun": "bun --hot apps/server/src/server.ts",
    "build": "electron-vite build",
    "build:desktop": "electron-vite build",
    "build:web": "node node_modules/vite/bin/vite.js build --config vite.config.mts",
    "build:server": "tsc -p tsconfig.server.json",
    "dist": "npm run build:desktop && electron-builder",
    "dist:linux": "npm run build:desktop && electron-builder --linux",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "preview": "electron-vite preview",
    "load:test": "node node_modules/tsx/dist/cli.mjs scripts/zenoh_load_test.ts",
    "scenario:run": "node node_modules/tsx/dist/cli.mjs scripts/zenoh_scenarios.ts",
    "scenario:once": "npm run scenario:run -- --once",
    "scenario:list": "npm run scenario:run -- --list",
    "start:web": "node dist/server/apps/server/src/server.js",
    "start:web:bun": "bun apps/server/src/server.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eclipse-zenoh/zenoh-ts": "^1.10.0",
    "protobufjs": "^8.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@eclipse-zenoh/zenoh-ts": {
      "uuid": "11.1.1"
    },
    "js-yaml": "4.3.1"
  },
  "build": {
    "appId": "com.carto.app",
    "productName": "Carto",
    "icon": "assets/web/icon-512.png",
    "files": [
      "out/**",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "assets/web/icon-512.png",
        "to": "logo.png"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Derek Diaz <derek.diaz@proton.me>",
      "category": "Utility",
      "icon": "assets/web/icon-512.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/web/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "packages/core/src/shared/icon.icns"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
